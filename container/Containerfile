# Bend 2 を試すためのコンテナ
#
#   既定（--target なし）: bend だけの最小構成。実行と --check-only まで
#   --target native      : 上に clang を足したもの。ネイティブビルド（bend x.bend -o x）もできる
#   --target gpu         : CUDA の NVRTC と clang 19 入り。`!` 付きの呼び出しを GPU で走らせる
#   --target verdict     : 最小構成に Lean を足したもの。--verdict（証明の再検査）ができる
#
# verdict 以外は --verdict（Lean が要る）を含まない。
# bend は glibc に動的リンクしているので、musl の Alpine では動かない。Debian slim を使う。
FROM debian:bookworm-slim AS slim

ARG BEND_VER=2.0.34
ARG BEND_SHA_X64=78106a97af242429dcc057258eb8d10f69cddebcd5e263022185a52d003e09bf
ARG BEND_SHA_ARM64=416a17d282a9fd05ab9637a238b51d5ca508114d9773c37d1c11cad595440ed1
# TARGETARCH: BuildKit がビルド先の CPU（amd64・arm64）を入れる。Apple Silicon の Docker では arm64 になり、
# エミュレーションなしで動く。空のとき（BuildKit 以外）は x64 版を取る
ARG TARGETARCH

RUN case "${TARGETARCH:-amd64}" in \
      amd64) arch=x64; sha="${BEND_SHA_X64}" ;; \
      arm64) arch=arm64; sha="${BEND_SHA_ARM64}" ;; \
      *) echo "bend の配布物が無い CPU: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && curl -fsSL -o /tmp/bend.tgz "https://github.com/bendlang/bend/releases/download/v${BEND_VER}/bend-${BEND_VER}-linux-${arch}.tar.gz" \
 && echo "${sha}  /tmp/bend.tgz" | sha256sum -c - \
 && mkdir -p /root/.bend/bin \
 && tar -xzf /tmp/bend.tgz -C /tmp \
 && mv /tmp/bend/bend2 /tmp/bend/guide /root/.bend/ \
 && mv /tmp/bend/bin/bend /root/.bend/bin/bend \
 && rm -rf /tmp/bend /tmp/bend.tgz \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# BEND_HOST: server/server.bend の待ち受け先。コンテナの外（-p で公開したポート）から届くよう 0.0.0.0 にする
ENV PATH="/root/.bend/bin:${PATH}" BEND_NO_TELEMETRY=1 BEND_HOST=0.0.0.0
EXPOSE 8080
WORKDIR /work
CMD ["bash"]

# ネイティブビルド用（wslc build --target native ...）
FROM slim AS native
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang libc6-dev \
 && rm -rf /var/lib/apt/lists/*

# GPU ビルド用（wslc build --target gpu ...、実行は wslc run --gpus all ...）
# bend は `!` 付きの呼び出しを含むプログラムを clang 19 以上と CUDA の NVRTC でビルドする。
# RTX 50 系（compute capability 12.0）には CUDA 12.8 以降の NVRTC が要る。
# cuda.h は cuda-cudart-dev に入っている（cuda-driver-dev には stubs の libcuda.so だけ）。
# libcuda.so の実体は実行時に --gpus で持ち込まれるので、ビルド時のリンクには stubs を使う。
# libomp は bench/ の C 版（OpenMP）を比較のためにビルドするときに使う。
FROM nvidia/cuda:12.9.1-base-ubuntu24.04 AS gpu
RUN apt-get update \
 && apt-get install -y --no-install-recommends clang-19 libc6-dev libomp-19-dev cuda-nvrtc-dev-12-9 cuda-cudart-dev-12-9 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/clang-19 /usr/local/bin/clang
COPY --from=slim /root/.bend /root/.bend
ENV PATH="/root/.bend/bin:${PATH}" BEND_NO_TELEMETRY=1 BEND_HOST=0.0.0.0 CUDA_HOME=/usr/local/cuda \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs
WORKDIR /work
CMD ["bash"]

# 証明の再検査用（wslc build --target verdict ...）。bend PROOF.bend --verdict には Lean v4.34.0 が要る。
# 初回の --verdict は Lean で書かれたカーネル（~/.bend/bendtt）をビルドするので、ここで一度済ませておく。
FROM slim AS verdict
ARG LEAN_VER=v4.34.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git \
 && curl -fsSL -o /tmp/elan-init.sh https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
 && sh /tmp/elan-init.sh -y --no-modify-path --default-toolchain "leanprover/lean4:${LEAN_VER}" \
 && rm -f /tmp/elan-init.sh \
 && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.elan/bin:${PATH}"
RUN mkdir -p /tmp/warm \
 && printf 'import Base\n\ndef one() -> Nat:\n  1n\n' > /tmp/warm/main.bend \
 && cd /tmp/warm && bend main.bend --verdict \
 && rm -rf /tmp/warm

# 既定のターゲットは最後の段になるので、最小構成をもう一度置く
FROM slim
